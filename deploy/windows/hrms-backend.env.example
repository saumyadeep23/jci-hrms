# Copy to a real path (e.g. C:\hrms\hrms-backend.env) and fill in real values, then pass that path
# to install-hrms-backend-service.ps1 -EnvFile. NEVER commit the filled-in copy - it holds the database
# password. One KEY=VALUE per line, no quoting, no export/set prefix (NSSM's AppEnvironmentExtra format).
#
# Every key below is read exactly as backend/src/main/resources/application.yml declares it - do not
# rename these.

# --- Database ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jcihrms?serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=jcihrms_admin
SPRING_DATASOURCE_PASSWORD=

# --- Auth (SEC-001, docs/security/SEC_001_002_REMEDIATION.md) ---
# 'local-dev' (HS256, JWT_LOCAL_DEV_SECRET below) for this LAN box unless a real OIDC IdP has been
# provisioned for it - AuthenticationModeGuard refuses to start with 'oidc' mode and a blank
# JWT_ISSUER_URI, and refuses 'local-dev' mode entirely on a staging/prod Spring profile.
SECURITY_AUTH_MODE=local-dev
JWT_LOCAL_DEV_SECRET=
JWT_ISSUER_URI=

# --- TLS (Root Cause B of the network/TLS closure task) ---
# Leave false. Port 8080 is plain HTTP - TLS terminates at the reverse proxy in production, and the
# frontend's Vite dev proxy (frontend/vite.config.ts) talks plain HTTP to this port in development.
# Do NOT set this true just because a browser somewhere requested https://<this-host>:8080 - that was
# the bug (see docs/DEPLOYMENT.md, Root Cause B), not a requirement.
SERVER_SSL_ENABLED=false

# --- Onboarding / bootstrap (see docs/security/ONBOARDING_IMPLEMENTATION.md) ---
HRMS_BOOTSTRAP_SYSTEM_ADMIN_EMPLOYEE_ID=8
HRMS_ONBOARDING_INVITATION_VALIDITY_HOURS=24
# The URL this backend puts into onboarding-activation emails - point it at wherever employees actually
# reach the frontend from (this LAN box's real address or, once provisioned, the approved HRMS hostname).
HRMS_FRONTEND_BASE_URL=http://10.0.11.100:5173

# --- Local document storage (PIMS_SPEC.md Section 3.C) ---
HRMS_STORAGE_LOCAL_DIR=./uploads
