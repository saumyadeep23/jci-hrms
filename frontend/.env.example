# Copy to .env.local (gitignored) only if you need to override the default.
#
# Default (unset): apiClient uses a RELATIVE '/api' baseURL. In `npm run dev` this is proxied by
# vite.config.ts's server.proxy to http://localhost:8080; in a production build served behind the
# reverse proxy (see docs/DEPLOYMENT.md) it resolves against that same origin. Leave this unset unless
# you have a specific reason not to use the proxy/reverse-proxy path.
#
# Set this only for an unusual setup where the frontend bundle is served from somewhere that does NOT
# proxy /api to the backend - it must be a full origin (scheme + host + port) you have verified actually
# serves this exact protocol; do not guess https:// here just because the frontend page itself is HTTPS.
# An http:// value set while the page itself is https:// is rejected at runtime (see
# resolveApiBaseUrl() in src/api/client.ts) - it falls back to the safe relative default and logs a
# console.error rather than silently sending credentials over a non-TLS connection.
# VITE_API_BASE_URL=http://localhost:8080/api

# `npm run dev` only (vite.config.ts's server.proxy target) - never read by a production build. Set
# this only if your backend isn't reachable at the default http://localhost:8080, e.g. a different port.
# VITE_DEV_BACKEND_TARGET=http://localhost:8080
